-- Fly
local function stopFlying()
	state.flying = false
	if flightConnection then
		flightConnection:Disconnect()
		flightConnection = nil
	end
	for _, object in ipairs({
		flightVelocity,
		flightOrientation,
		flightAttachment,
	}) do
		if object then
			object:Destroy()
		end
	end
	flightVelocity = nil
	flightOrientation = nil
	flightAttachment = nil
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
	setToggle(flyToggle, "Fly", false)
	updateMainLayout()
end
local function startFlying()
	if not humanoid or not rootPart then
		return
	end
	state.flying = true
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	flightAttachment = Instance.new("Attachment")
	flightAttachment.Parent = rootPart
	flightVelocity = Instance.new("LinearVelocity")
	flightVelocity.Attachment0 = flightAttachment
	flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flightVelocity.MaxForce = math.huge
	flightVelocity.VectorVelocity = Vector3.zero
	flightVelocity.Parent = rootPart
	flightOrientation = Instance.new("AlignOrientation")
	flightOrientation.Attachment0 = flightAttachment
	flightOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	flightOrientation.MaxTorque = math.huge
	flightOrientation.Responsiveness = 100
	flightOrientation.RigidityEnabled = true
	flightOrientation.Parent = rootPart
	setToggle(flyToggle, "Fly", true)
	updateMainLayout()
	flightConnection = RunService.RenderStepped:Connect(function()
		if not state.flying or not rootPart.Parent then
			return
		end
		local camera = workspace.CurrentCamera
		local direction = Vector3.zero
		if keys.w then
			direction += camera.CFrame.LookVector
		end
		if keys.s then
			direction -= camera.CFrame.LookVector
		end
		if keys.d then
			direction += camera.CFrame.RightVector
		end
		if keys.a then
			direction -= camera.CFrame.RightVector
		end
		if keys.up then
			direction += Vector3.yAxis
		end
		if keys.down then
			direction -= Vector3.yAxis
		end
		if direction.Magnitude > 0 then
			direction = direction.Unit
		end
		local speed = state.flyModifier
			and math.clamp(state.flySpeed, 1, 300)
			or 50
		flightVelocity.VectorVelocity = direction * speed
		flightOrientation.CFrame = camera.CFrame.Rotation
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end)
end
flyToggle.MouseButton1Click:Connect(function()
	if state.flying then
		stopFlying()
	else
		startFlying()
	end
end)
