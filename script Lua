	local direction = {1, 0}
	local nextDirection = {1, 0}
	local food = {13, 9}
	local objects = {}
	local timer = 0
	local score = 0
	local function draw()
		for _, object in ipairs(objects) do
			object:Destroy()
		end
		table.clear(objects)
		for index, segment in ipairs(snake) do
			table.insert(
				objects,
				cell(
					board,
					segment[1],
					segment[2],
					20,
					index == 1 and colors.knob or colors.fill
				)
			)
		end
		table.insert(objects, cell(board, food[1], food[2], 20, colors.red))
		scoreLabel.Text = "Score: " .. score
	end
	local function spawnFood()
		repeat
			food = {math.random(1, 18), math.random(1, 18)}
			local occupied = false
			for _, segment in ipairs(snake) do
				if segment[1] == food[1] and segment[2] == food[2] then
					occupied = true
				end
			end
		until not occupied
	end
	UIS.InputBegan:Connect(function(input)
		if activeGame ~= "Snake" then
			return
		end
		if input.KeyCode == Enum.KeyCode.Up and direction[2] ~= 1 then
			nextDirection = {0, -1}
		elseif input.KeyCode == Enum.KeyCode.Down and direction[2] ~= -1 then
			nextDirection = {0, 1}
		elseif input.KeyCode == Enum.KeyCode.Left and direction[1] ~= 1 then
			nextDirection = {-1, 0}
		elseif input.KeyCode == Enum.KeyCode.Right and direction[1] ~= -1 then
			nextDirection = {1, 0}
		end
	end)
	draw()
	activeConnection = RunService.Heartbeat:Connect(function(delta)
		if activeGame ~= "Snake" then
			return
		end
		timer += delta
		if timer < 0.13 then
			return
		end
		timer = 0
		direction = nextDirection
		local head = snake[1]
		local newHead = {
			head[1] + direction[1],
			head[2] + direction[2],
		}
		if newHead[1] < 1 or newHead[1] > 18
			or newHead[2] < 1 or newHead[2] > 18 then
			closeGame()
			return
		end
		for _, segment in ipairs(snake) do
			if segment[1] == newHead[1]
				and segment[2] == newHead[2] then
				closeGame()
				return
			end
		end
		table.insert(snake, 1, newHead)
		if newHead[1] == food[1] and newHead[2] == food[2] then
			score += 10
			spawnFood()
		else
			table.remove(snake)
		end
		draw()
	end)
end
