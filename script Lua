-- Otimização
local function optimize(object)
	if optimizedObjects[object] then
		return
	end
	if object:IsA("Decal") or object:IsA("Texture") then
		optimizedObjects[object] = {
			property = "Transparency",
			value = object.Transparency,
		}
		object.Transparency = 1
	elseif object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("PostEffect") then
		optimizedObjects[object] = {
			property = "Enabled",
			value = object.Enabled,
		}
		object.Enabled = false
	end
end
optimizationToggle.MouseButton1Click:Connect(function()
	state.optimization = not state.optimization
	if state.optimization then
		for _, object in ipairs(workspace:GetDescendants()) do
			optimize(object)
		end
		for _, object in ipairs(Lighting:GetChildren()) do
			optimize(object)
		end
	else
		for object, data in pairs(optimizedObjects) do
			if object.Parent then
				object[data.property] = data.value
			end
		end
		table.clear(optimizedObjects)
	end
	setToggle(
		optimizationToggle,
		"Otimização de jogo",
		state.optimization
	)
end)
workspace.DescendantAdded:Connect(function(object)
	if state.optimization then
		task.defer(optimize, object)
	end
end)
