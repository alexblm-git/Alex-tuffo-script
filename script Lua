local function slider(parent, text, minimum, maximum, value, y, callback)
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, 0, 0, 61)
	box.Position = UDim2.fromOffset(0, y)
	box.BackgroundTransparency = 1
	box.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Text = text .. ": " .. value
	label.TextColor3 = colors.text
	label.TextSize = 12
	label.Font = Enum.Font.Code
	label.Parent = box
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 8)
	bar.Position = UDim2.fromOffset(0, 25)
	bar.BackgroundColor3 = colors.slider
	bar.BorderColor3 = colors.border
	bar.Parent = box
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0)
	fill.BackgroundColor3 = colors.fill
	fill.Parent = bar
	local knob = Instance.new("TextButton")
	knob.Size = UDim2.fromOffset(14, 14)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(
		(value - minimum) / (maximum - minimum),
		0,
		0.5,
		0
	)
	knob.BackgroundColor3 = colors.knob
	knob.BorderColor3 = colors.border
	knob.Text = ""
	knob.Parent = bar
	interactive(box)
	interactive(bar)
	interactive(knob)
	local dragging = false
	local function update(mouseX)
		local percentage = math.clamp(
			(mouseX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)
		local newValue = math.floor(
			minimum + (maximum - minimum) * percentage + 0.5
		)
		fill.Size = UDim2.new(percentage, 0, 1, 0)
		knob.Position = UDim2.new(percentage, 0, 0.5, 0)
		label.Text = text .. ": " .. newValue
		callback(newValue)
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			update(input.Position.X)
		end
	end)
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			update(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	return box
end
