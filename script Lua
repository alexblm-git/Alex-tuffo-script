local function findPlayerForTeleport(query)
    local normalized = string.lower(string.gsub(query, "^%s*(.-)%s*$", "%1"))
    if normalized == "" then
        return nil
    end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if string.lower(targetPlayer.Name) == normalized
            or string.lower(targetPlayer.DisplayName) == normalized then
            return targetPlayer
        end
    end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if string.sub(string.lower(targetPlayer.Name), 1, #normalized) == normalized then
            return targetPlayer
        end
    end
    return nil
end
